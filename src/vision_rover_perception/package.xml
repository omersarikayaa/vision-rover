<?xml version="1.0"?>
<package format="3">
  <name>vision_rover_perception</name>
  <version>0.1.0</version>
  <description>OpenCV and YOLO perception pipeline for Vision Rover camera images.</description>
  <maintainer email="developer@example.com">Vision Rover Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
