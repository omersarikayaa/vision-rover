<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="vision_rover_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.35 0.45 0.35 1</ambient><diffuse>0.35 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_red">
      <static>true</static><pose>2 0.8 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="box_blue">
      <static>true</static><pose>3 -1.2 0.5 0 0 0.35</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1 0.5 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1 0.5 1</size></box></geometry><material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual></link>
    </model>
    <model name="box_yellow">
      <static>true</static><pose>1.5 -2.2 0.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.5 1 0.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.5 1 0.5</size></box></geometry><material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="vision_rover">
      <pose>0 0 0.12 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.12</ixx><iyy>0.20</iyy><izz>0.28</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="body_collision">
          <pose>0 0 0.22 0 0 0</pose><geometry><box><size>0.62 0.38 0.20</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.22 0 0 0</pose><geometry><box><size>0.62 0.38 0.20</size></box></geometry>
          <material><ambient>0.12 0.35 0.65 1</ambient><diffuse>0.12 0.35 0.65 1</diffuse></material>
        </visual>
        <visual name="front_marker">
          <pose>0.315 0 0.23 0 0 0</pose><geometry><box><size>0.02 0.24 0.08</size></box></geometry>
          <material><ambient>0.9 0.5 0.05 1</ambient><diffuse>0.9 0.5 0.05 1</diffuse></material>
        </visual>
      </link>

      <link name="front_left_wheel">
        <pose relative_to="base_link">0.22 0.24 0 1.570796 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <link name="rear_left_wheel">
        <pose relative_to="base_link">-0.22 0.24 0 1.570796 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <link name="front_right_wheel">
        <pose relative_to="base_link">0.22 -0.24 0 1.570796 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <link name="rear_right_wheel">
        <pose relative_to="base_link">-0.22 -0.24 0 1.570796 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>

      <joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="rear_left_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="front_right_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="rear_right_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>

      <link name="camera_link">
        <pose relative_to="base_link">0.32 0 0.29 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="camera_visual"><geometry><box><size>0.06 0.10 0.07</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <sensor name="front_camera" type="camera">
          <topic>/camera/image</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
        </sensor>
      </link>
      <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_joint</left_joint>
        <left_joint>rear_left_joint</left_joint>
        <right_joint>front_right_joint</right_joint>
        <right_joint>rear_right_joint</right_joint>
        <wheel_separation>0.48</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
      </plugin>
    </model>
  </world>
</sdf>
